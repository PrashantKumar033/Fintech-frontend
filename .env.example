VITE_API_URL=http://localhost:8000
# Development-only biometric simulator. Never enable this in a production environment.
VITE_AEPS_USE_MOCK_PID=false

# Permission rollout mode:
# compat = use exact permissions when loaded, otherwise keep today's role-based navigation.
# strict = deny protected UI when no exact permission is granted. Use this in production after backend permission seeding is complete.
VITE_PERMISSION_ENFORCEMENT=compat
